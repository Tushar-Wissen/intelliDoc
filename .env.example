# IntelliDoc Environment Configuration Template
# Copy to `.env` for local overrides. Do not commit `.env`.

# Postgres (docker-compose defaults work for local POC)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intellidoc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Core API
SPRING_BOOT_PORT=8080
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=change-me-poc-only-must-be-at-least-256-bits-long
JWT_EXPIRY_SECONDS=86400

# AI Service
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO

# Neo4j (consumed starting Epic 5)
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_URI=bolt://localhost:7687

# Redis (consumed starting Epic 1/2)
REDIS_URL=redis://localhost:6379

# MinIO (consumed starting Epic 1)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=intellidoc
MAX_FILE_SIZE_BYTES=20971520
ALLOWED_FILE_EXTENSIONS=pdf,docx

# Frontend
REACT_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# Legacy Supabase keys kept so the current UI can still be configured.
# Auth for the Core API is JWT (POST /auth/login), not Supabase Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
