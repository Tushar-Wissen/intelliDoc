# IntelliDoc Environment Configuration Template
# Copy to `.env` for local overrides. Do not commit `.env`.

# Postgres (docker-compose defaults work for local POC)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intellidoc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Core API
SPRING_BOOT_PORT=8080
AI_SERVICE_URL=http://localhost:8000
JWT_SECRET=change-me-poc-only-must-be-at-least-256-bits-long
JWT_EXPIRY_SECONDS=86400

# AI Service
AI_SERVICE_PORT=8000
LOG_LEVEL=INFO
CELERY_BROKER_URL=redis://localhost:6379/0
OCR_TEXT_DENSITY_THRESHOLD=80
CHUNK_TOKEN_TARGET_MIN=200
CHUNK_TOKEN_TARGET_MAX=500
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.5
LLM_MAX_CONTEXT_CHUNKS=50
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MODEL_NAME=BAAI/bge-m3
IDENTIFIER_QUERY_MIN_LENGTH=3
LLM_PROVIDER=rules
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
HOSTED_LLM_BASE_URL=https://api.openai.com/v1
HOSTED_LLM_API_KEY=
HOSTED_LLM_MODEL=gpt-4o-mini
KG_ENTITY_NORMALIZATION_STRATEGY=baseline

# Epic 6 retrieval. Defaults match app/retrieval/config.py.
RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_KEYWORD_TOP_K=20
RETRIEVAL_GRAPH_MAX_HOPS=2
RETRIEVAL_GRAPH_MAX_FACTS=30
MERGE_MAX_CANDIDATES=40
RERANK_INPUT_SIZE=30
PACKAGE_MAX_CHUNKS=8
PACKAGE_MAX_CHUNKS_SUMMARY=12
PACKAGE_MAX_TOKENS=3000
BALANCE_MAX_SHARE=0.6
BALANCE_FANOUT_MAX_DOCS=6
CLASSIFIER_CONTEXT_TURNS=3
CLASSIFIER_MAX_QUESTION_CHARS=2000
RETRIEVAL_DB_TIMEOUT_MS=2000
RETRIEVAL_GRAPH_TIMEOUT_MS=2000
RETRIEVAL_LLM_TIMEOUT_MS=8000
RETRIEVAL_RERANK_TIMEOUT_MS=3000
# degrade: live chat continues with graphStatus=FAILED. fail: evaluation runs raise GRAPH_UNAVAILABLE.
RETRIEVAL_GRAPH_FAILURE=degrade
RETRIEVAL_GRAPH_ENABLED=true
# overlap is deterministic and needs no model download. Set bge to load the cross-encoder.
RERANKER_PROVIDER=overlap
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# Neo4j (consumed starting Epic 5)
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_URI=bolt://localhost:7687

# Redis (consumed starting Epic 1/2)
REDIS_URL=redis://localhost:6379

# MinIO (consumed starting Epic 1)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=intellidoc
MAX_FILE_SIZE_BYTES=20971520
ALLOWED_FILE_EXTENSIONS=pdf,docx

# Frontend
REACT_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# Legacy Supabase keys kept so the current UI can still be configured.
# Auth for the Core API is JWT (POST /auth/login), not Supabase Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
